# downlink.options
# Nanopb per-field options for server→collar downlink messages.

# Max 8 vertices per geofence (keeps wire size under ~70 bytes per fence)
GeofenceData.vertices  max_count:8

# Beacon key set (CMD_BEACON_KEY_SET): the derived AES-128 key is exactly
# 16 bytes, like the LoRaWAN keys in ble.options. A frame carrying any other
# length fails to decode, so a malformed key never reaches the store.
BeaconKeySet.key       max_size:16 fixed_length:true

# Bluetooth file window key (CMD_BLE_WINDOW): exactly 16 bytes, like the
# beacon key. Any other length fails to decode, so the window never opens on
# a short key.
BleWindow.key          max_size:16 fixed_length:true

# A software update through the window (2026-11-26): the image's SHA-256 is
# exactly 32 bytes and its release signature exactly 64 (r|s). Any other
# length fails to decode, so the command is never acted on; absent reads as
# all zeros, which the collar refuses (ACK 12, detail 9).
BleWindow.image_sha256 max_size:32 fixed_length:true
BleWindow.image_sig    max_size:64 fixed_length:true
