# message.options
# Nanopb per-field options to keep generated C small & static.

# ---- Repeated limits -------------------------------------------------------
ScheduleConfigPacket.schedules        max_count:5

# ---- BLE config tunnel (fw 305+) -------------------------------------------
# cfg_downlink: one DownlinkPacket. Largest tunneled frame is a ConfigFragment
# downlink (~80 B encoded); 96 leaves margin without bloating the BlePacket
# union (these fields live on the schedule arm, which every sender allocates).
# fence_report: version byte + one fence's fixed binary record
# (1 + 16 + 8 verts x 8 B = 81 B worst case). The whole echo BlePacket stays
# well under the 350 B characteristic cap the deployed WB chips enforce.
ScheduleConfigPacket.cfg_downlink     max_size:96
CfgEchoPacket.fence_report            max_size:88
# slot_report: one ScheduleConfig, nanopb-lean. 128 keeps the whole echo
# BlePacket under the 182 B single-read limit for any realistic slot.
CfgEchoPacket.slot_report             max_size:128
# mag_cal (MagCalReport) is scalars only and needs no options. It rides only
# on status echoes (no fence_report/slot_report): at most 26 B, which puts
# the worst status echo at 88 B.
# beacon_key (BeaconKeyReport): kcv is the 3-byte key check value, empty
# while no key is held, so NOT fixed_length (an unkeyed report must encode
# nothing for it). Status echoes only, like mag_cal: at most 20 B, which puts
# the worst status echo at 108 B.
BeaconKeyReport.kcv                   max_size:3

# ---- Fixed-size credentials (no dynamic allocation) -----------------------
# OTAA
RadioOTAA.dev_eui                     max_size:8  fixed_length:true
RadioOTAA.join_eui                    max_size:8  fixed_length:true
RadioOTAA.app_key                     max_size:16 fixed_length:true
RadioOTAA.nwk_key                     max_size:16 fixed_length:true

# ABP
RadioABP.dev_addr                     max_size:4  fixed_length:true
RadioABP.nwk_s_key                    max_size:16 fixed_length:true
RadioABP.app_s_key                    max_size:16 fixed_length:true
RadioABP.f_nwk_s_int_key              max_size:16 fixed_length:true
RadioABP.s_nwk_s_int_key              max_size:16 fixed_length:true

# ---- Strings: cap lengths --------------------------------------------------
# Keep firmware_version short to avoid large buffers.
SystemStatePacket.firmware_version    max_size:16

# ---- Fixed size for MAC address -------------------------------------------
PeripheralPacket.mac_address          max_size:6  fixed_length:true

# Notes:
# - Fixed-length bytes avoid length checks and heap use in embedded targets.
# - max_count on 'schedules' creates a fixed array in the struct (no malloc).
# - max_size on strings/bytes prevents unbounded buffers in generated code.
# - Options don’t change the Protobuf wire format—just the generated C and memory use.
